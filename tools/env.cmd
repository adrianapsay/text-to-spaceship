@echo off
rem Session-only environment for the project toolchain. Nothing is written to the
rem registry or the user profile. Usage (cmd):  call D:\text-to-spaceship\tools\env.cmd
set "T2S_TOOLS=%~dp0"
set "T2S_TOOLS=%T2S_TOOLS:~0,-1%"
for %%I in ("%T2S_TOOLS%\..") do set "T2S_ROOT=%%~fI"
set "UV_CACHE_DIR=%T2S_TOOLS%\cache\uv"
set "UV_PYTHON_INSTALL_DIR=%T2S_TOOLS%\python"
set "UV_PYTHON_CACHE_DIR=%T2S_TOOLS%\cache\uv-python"
set "UV_PYTHON_BIN_DIR=%T2S_TOOLS%\bin"
set "UV_TOOL_DIR=%T2S_TOOLS%\uv-tools"
set "UV_TOOL_BIN_DIR=%T2S_TOOLS%\bin"
set "UV_PYTHON_INSTALL_BIN=0"
set "UV_PYTHON_INSTALL_REGISTRY=0"
set "UV_PYTHON_NO_REGISTRY=1"
set "UV_PYTHON_PREFERENCE=only-managed"
set "UV_NO_MODIFY_PATH=1"
set "npm_config_cache=%T2S_TOOLS%\cache\npm"
set "npm_config_prefix=%T2S_TOOLS%\npm-global"
set "npm_config_update_notifier=false"
set "PLAYWRIGHT_BROWSERS_PATH=%T2S_TOOLS%\ms-playwright"
set "GIT_CONFIG_GLOBAL=%T2S_TOOLS%\gitconfig"
set "GIT_CONFIG_NOSYSTEM=1"
set "NUMBA_CACHE_DIR=%T2S_TOOLS%\cache\numba"
set "PYTHONUTF8=1"
set "PATH=%T2S_TOOLS%\uv;%T2S_TOOLS%\node;%T2S_TOOLS%\mingit\cmd;%T2S_TOOLS%\bin;%PATH%"
