{
  "name": "t2s-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "TEXT-TO-SPACESHIP front end (CubeSat 3D packaging optimiser UI)",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "node scripts/build-mock-fixtures.mjs --if-missing",
    "dev": "vite",
    "predev:mock": "node scripts/build-mock-fixtures.mjs --if-missing",
    "dev:mock": "vite --mode mock",
    "prebuild": "node scripts/build-mock-fixtures.mjs --if-missing",
    "build": "tsc -p tsconfig.json && vite build",
    "pretest": "node scripts/build-mock-fixtures.mjs --if-missing",
    "pree2e": "node scripts/build-mock-fixtures.mjs --if-missing",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "fixtures": "node scripts/build-mock-fixtures.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@observablehq/plot": "0.6.17",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
